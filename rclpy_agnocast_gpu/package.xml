  <description>Stream-bound CUDA Tensor ownership for the Agnocast Python adapter.</description>
  <maintainer email="maintainers@example.com">rclpy zerocopy maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
